{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DDC Control",
  "mainBinaryName": "ddc-tray",
  "identifier": "io.github.slipalison.ddc-control",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popup",
        "title": "DDC Control",
        "width": 360,
        "height": 560,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Alison Amorim",
    "category": "Utility",
    "shortDescription": "Monitor brightness, contrast, input and more from the system tray, over DDC/CI",
    "longDescription": "A system-tray popup that adjusts what the monitor's own OSD offers: brightness, contrast, volume, color preset, input source and power, over DDC/CI. Dangerous changes ask for confirmation first.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "MIT",
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/60-ddc-control-i2c.rules": "../../../packaging/linux/60-ddc-control-i2c.rules",
          "/usr/lib/modules-load.d/ddc-control.conf": "../../../packaging/linux/ddc-control-i2c-dev.conf"
        },
        "postInstallScript": "../../../packaging/linux/postinstall.sh"
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/60-ddc-control-i2c.rules": "../../../packaging/linux/60-ddc-control-i2c.rules",
          "/usr/lib/modules-load.d/ddc-control.conf": "../../../packaging/linux/ddc-control-i2c-dev.conf"
        },
        "postInstallScript": "../../../packaging/linux/postinstall.sh"
      }
    }
  }
}
